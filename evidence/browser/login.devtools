<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
        <meta http-equiv="Access-Control-Allow-Origin" content="*" />
        <meta name="renderer" content="webkit" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <title>认证中心</title>
        <link rel="shortcut icon" type="image/x-icon" href="https://ywtb.swu.edu.cn" />
        <!--<link rel="icon" href="../favicon.ico">-->
        <!-- 引入外部 CSS -->
        <link href="https://ywtb.swu.edu.cn/center-auth-server/static-center-auth-server/purenative/css/login.css?v=7.0.2.1" rel="stylesheet" />
        <script src="https://ywtb.swu.edu.cn/center-auth-server/static-center-auth-server/js/xhrAxios.js?v=7.0.2.1"></script>
        <script src="https://ywtb.swu.edu.cn/center-auth-server/static-center-auth-server/js/jsencrypt.js?v=7.0.2.1"></script>
        <!--<script th:src="${serverUrlStatic}+'/js/qrcode.min.js?v='+${staticVersion}"></script>-->
        <script src="https://ywtb.swu.edu.cn/center-auth-server/static-center-auth-server/js/qrcode.min.new.js?v=7.0.2.1"></script>
        <script src="https://ywtb.swu.edu.cn/center-auth-server/static-center-auth-server/purenative/js/jquery-3.6.0.min.js"></script>
        <script src="https://ywtb.swu.edu.cn/center-auth-server/static-center-auth-server/purenative/js/common.js?v=7.0.2.1"></script>
        <script src="https://ywtb.swu.edu.cn/center-auth-server/static-center-auth-server/purenative/js/login.js?v=7.0.2.1"></script>
        <!--[if lt IE 10]>
